# Django core
DEBUG=False
DJANGO_SECRET_KEY=replace-with-strong-random-secret
SECRET_KEY=replace-with-strong-random-secret
ALLOWED_HOSTS=tinchlik24.uz,www.tinchlik24.uz,localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=https://tinchlik24.uz,https://www.tinchlik24.uz
SITE_NAME=TINCHLIK
SITE_URL=https://tinchlik24.uz
PUBLIC_BASE_URL=https://tinchlik24.uz
SITE_DOMAIN=tinchlik24.uz
DEFAULT_FROM_EMAIL=noreply@tinchlik24.uz

# Database
DATABASE_URL=postgres://username:password@hostname:5432/database_name

# Email SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_email_app_password

# Telegram / bot settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
ADMIN_BOT_TOKEN=your_admin_bot_token
ADMIN_BOT_WEBHOOK_SECRET=your_admin_webhook_secret
USER_BOT_TOKEN=your_user_bot_token
USER_BOT_USERNAME=tinchlik_verificationbot
USER_BOT_WEBHOOK_SECRET=your_user_webhook_secret
ADMIN_TELEGRAM_IDS=123456789
ADMIN_PHONE_NUMBER=+998901234567
TELEGRAM_GATEWAY_TOKEN=your_gateway_token
MAIN_ADMIN_USERNAME=admin
MAIN_ADMIN_PASSWORD=change_me

# Optional system settings
BOT_LOGIN_MAX_ATTEMPTS=5
BOT_LOGIN_BLOCK_MINUTES=15
TELEGRAM_GATEWAY_RESEND_COOLDOWN_SECONDS=60
TELEGRAM_GATEWAY_CODE_TTL_SECONDS=300
PENDING_REGISTRATION_EXPIRE_MINUTES=30
VALIDATION_LINK_TTL_MINUTES=10
